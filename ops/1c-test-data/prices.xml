            <Валюта>RUB</Валюта>
          </Цена>
        </Цены>
      </Предложение>
      <Предложение>
        <Ид>PROD-00003</Ид>
        <Цены>
          <Цена>
            <ИдТипаЦены>PRICE-TYPE-001</ИдТипаЦены>
            <ЦенаЗаЕдиницу>990.00</ЦенаЗаЕдиницу>
            <Валюта>RUB</Валюта>
          </Цена>
        </Цены>
      </Предложение>
    </Предложения>
  </ПакетПредложений>
</КоммерческаяИнформация>
