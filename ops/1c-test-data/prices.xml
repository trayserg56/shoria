<?xml version="1.0" encoding="UTF-8"?>
<!--
  prices.xml — отдельный файл цен (CommerceML 2).
  Используется конфигурациями: 1С УТ 11, КА 2, ERP при разделённой выгрузке.
  Содержит только цены без остатков.

  Использование:
    curl -u 1c:secret -X POST "localhost:8080/api/1c/exchange?type=catalog&mode=file&filename=prices.xml" -d @prices.xml
    curl -u 1c:secret "localhost:8080/api/1c/exchange?type=catalog&mode=import&filename=prices.xml"
-->
<КоммерческаяИнформация xmlns="urn:1C.ru:commerceml_2" ВерсияСхемы="2.05">
  <ПакетПредложений>
    <Ид>PRICES-001</Ид>
    <Наименование>Цены товаров</Наименование>

