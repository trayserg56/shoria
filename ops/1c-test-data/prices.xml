        <Ид>PRICE-TYPE-002</Ид>
        <Наименование>Оптовая</Наименование>
        <Валюта>RUB</Валюта>
      </ТипЦены>
    </ТипыЦен>

    <Предложения>
      <Предложение>
        <Ид>PROD-00001#VAR-001</Ид>
        <Цены>
          <Цена>
            <ИдТипаЦены>PRICE-TYPE-001</ИдТипаЦены>
            <ЦенаЗаЕдиницу>8990.00</ЦенаЗаЕдиницу>
