<?xml version="1.0" encoding="UTF-8"?>
<!--
  rests.xml — отдельный файл остатков (CommerceML 2).
  Используется конфигурациями: 1С УТ 11, КА 2, ERP при разделённой выгрузке.
  Содержит только остатки по складам без цен.

  Использование:
    curl -u 1c:secret -X POST "localhost:8080/api/1c/exchange?type=catalog&mode=file&filename=rests.xml" -d @rests.xml
    curl -u 1c:secret "localhost:8080/api/1c/exchange?type=catalog&mode=import&filename=rests.xml"
-->
<КоммерческаяИнформация xmlns="urn:1C.ru:commerceml_2" ВерсияСхемы="2.05">
  <ПакетПредложений>
    <Ид>RESTS-001</Ид>
    <Наименование>Остатки товаров</Наименование>

    <Склады>
      <Склад>
        <Ид>WH-MAIN-001</Ид>
        <Наименование>Основной склад Москва</Наименование>
      </Склад>
      <Склад>
        <Ид>WH-SPB-001</Ид>
        <Наименование>Склад Санкт-Петербург</Наименование>
      </Склад>
    </Склады>

    <Предложения>
      <Предложение>
        <Ид>PROD-00001#VAR-001</Ид>
        <Склады>
          <СкладОстаток>
            <ИдСклада>WH-MAIN-001</ИдСклада>
            <Количество>10</Количество>
          </СкладОстаток>
          <СкладОстаток>
            <ИдСклада>WH-SPB-001</ИдСклада>
            <Количество>5</Количество>
          </СкладОстаток>
        </Склады>
      </Предложение>
      <Предложение>
        <Ид>PROD-00003</Ид>
        <Склады>
          <СкладОстаток>
            <ИдСклада>WH-MAIN-001</ИдСклада>
            <Количество>200</Количество>
          </СкладОстаток>
          <СкладОстаток>
            <ИдСклада>WH-SPB-001</ИдСклада>
            <Количество>50</Количество>
          </СкладОстаток>
        </Склады>
      </Предложение>
    </Предложения>
  </ПакетПредложений>
</КоммерческаяИнформация>
